# =============================================================================
# TURSO DISTRIBUTED SQLITE CONFIGURATION
# =============================================================================
#
# This configuration enables Turso-inspired distributed SQLite database
# operations with embedded replicas, WAL-based replication, and multi-node sync.
#
# Copy this file to .env.turso and update the values.
#

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database type (sqlite or postgres)
DB_TYPE=sqlite

# SQLite database path (primary database)
SQLITE_PATH=./data/personalitymatch.db

# =============================================================================
# TURSO REPLICATION SETTINGS
# =============================================================================

# Enable Turso replication (true/false)
TURSO_REPLICA_ENABLED=true

# Replica mode (embedded or remote)
# - embedded: Local SQLite file synced with primary
# - remote: Remote database accessed via HTTP
TURSO_REPLICA_MODE=embedded

# Embedded replica database path
TURSO_REPLICA_PATH=./data/replica.db

# Enable automatic synchronization (true/false)
TURSO_AUTO_SYNC=true

# Synchronization interval in milliseconds
# How often to sync changes between primary and replicas
TURSO_SYNC_INTERVAL=5000

# =============================================================================
# PRIMARY DATABASE SETTINGS
# =============================================================================

# Enable primary database mode (true/false)
# Set to true if this is the primary (source) database
TURSO_PRIMARY_ENABLED=true

# Primary database URL (use 'local' for local database)
TURSO_PRIMARY_URL=local

# Primary database location identifier
TURSO_PRIMARY_LOCATION=local

# Authentication token for primary database
# Generate a secure random token: openssl rand -hex 32
TURSO_PRIMARY_AUTH_TOKEN=change-me-to-secure-random-token

# =============================================================================
# REPLICATION NODES
# =============================================================================

# Additional replication nodes (JSON array)
# Configure multiple replicas across different locations
#
# Example:
# TURSO_NODES='[
#   {"id":"us-east","type":"remote","url":"https://us-east.api.com","location":"us-east"},
#   {"id":"eu-west","type":"remote","url":"https://eu-west.api.com","location":"eu-west"},
#   {"id":"ap-south","type":"remote","url":"https://ap-south.api.com","location":"ap-south"}
# ]'
#
TURSO_NODES=[]

# =============================================================================
# WAL (Write-Ahead Log) CONFIGURATION
# =============================================================================

# Enable WAL frame synchronization (true/false)
TURSO_WAL_ENABLED=true

# Frame buffer size (number of frames)
# Frames are batched before sending to replicas
TURSO_WAL_BUFFER_SIZE=1000

# WAL checkpoint interval in milliseconds
# How often to perform a WAL checkpoint (move WAL to main DB)
TURSO_WAL_CHECKPOINT_INTERVAL=10000

# Enable WAL frame compression (true/false)
# Reduces network bandwidth but increases CPU usage
TURSO_WAL_COMPRESSION=false

# =============================================================================
# SYNCHRONIZATION STRATEGY
# =============================================================================

# Sync strategy (eventual or strong)
# - eventual: Replicas may be slightly behind (faster, lower overhead)
# - strong: Replicas must acknowledge before write completes (slower, consistent)
TURSO_SYNC_STRATEGY=eventual

# Conflict resolution strategy (last-write-wins or custom)
# - last-write-wins: Most recent timestamp wins
# - custom: Implement custom resolution logic
TURSO_CONFLICT_RESOLUTION=last-write-wins

# Batch size for synchronization operations
TURSO_SYNC_BATCH_SIZE=100

# Maximum retry attempts for failed syncs
TURSO_SYNC_MAX_RETRIES=3

# Delay between retry attempts in milliseconds
TURSO_SYNC_RETRY_DELAY=1000

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

# SQLite page cache size (in pages, 1 page = 4KB)
# Higher values improve read performance but use more memory
# Example: 2000 pages = 8MB cache
TURSO_CACHE_SIZE=2000

# Memory-mapped I/O size in bytes
# 0 = disabled, >0 = use mmap for this many bytes
# Example: 30GB = 30000000000 bytes
TURSO_MMAP_SIZE=30000000000

# Busy timeout in milliseconds
# How long to wait if database is locked
TURSO_BUSY_TIMEOUT=5000

# Journal mode (DELETE, TRUNCATE, PERSIST, MEMORY, WAL, OFF)
# WAL (Write-Ahead Log) is recommended for best concurrency
TURSO_JOURNAL_MODE=WAL

# Synchronous mode (OFF, NORMAL, FULL, EXTRA)
# - OFF: Fastest, least safe (risk of corruption on crash)
# - NORMAL: Good balance of speed and safety
# - FULL: Safest, slowest
TURSO_SYNCHRONOUS=NORMAL

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Enable database encryption (true/false)
# Requires SQLCipher or similar
TURSO_ENCRYPTION_ENABLED=false

# Encryption key (if encryption is enabled)
# TURSO_ENCRYPTION_KEY=your-encryption-key-here

# Enable TLS for remote connections (true/false)
TURSO_TLS_ENABLED=true

# Require authentication for replication API (true/false)
TURSO_AUTH_REQUIRED=true

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================

# Enable monitoring and metrics (true/false)
TURSO_MONITORING_ENABLED=true

# Metrics collection interval in milliseconds
TURSO_METRICS_INTERVAL=60000

# Log level (debug, info, warn, error)
TURSO_LOG_LEVEL=info

# =============================================================================
# APPLICATION SETTINGS (from original config)
# =============================================================================

# Node environment
NODE_ENV=production

# Server port
PORT=3001

# JWT secret for authentication
JWT_SECRET=change-me-to-secure-random-secret

# CORS allowed origins
CORS_ORIGIN=https://yourdomain.com

# =============================================================================
# WOMPI PAYMENT CONFIGURATION
# =============================================================================

# Wompi public key (from dashboard)
WOMPI_PUBLIC_KEY=pub_prod_xxxxx

# Wompi private key (from dashboard)
WOMPI_PRIVATE_KEY=prv_prod_xxxxx

# Wompi integrity secret (from dashboard)
WOMPI_INTEGRITY_SECRET=xxxxx

# Wompi environment (sandbox or production)
WOMPI_ENVIRONMENT=production

# Wompi currency
WOMPI_CURRENCY=COP

# Unlock price in USD
UNLOCK_PRICE_USD=1.00

# USD to COP exchange rate
USD_TO_COP_RATE=4000

# =============================================================================
# EMAIL CONFIGURATION (Brevo)
# =============================================================================

# Brevo SMTP settings
SMTP_HOST=smtp-relay.sendinblue.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_brevo_smtp_key

# Email from address
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=PersonalityMatch

# =============================================================================
# ESTIMATED MONTHLY COST
# =============================================================================
#
# With this Turso distributed SQLite configuration:
#
# VPS (Hetzner CPX11):              $5.00/month
