#
# =============================================================================
# DEPLOYMENT MODES
# =============================================================================
#
# Mode 1: Standalone (Development)
#   TURSO_REPLICA_ENABLED=false
#   Best for: Local dev, testing, single-server
#
# Mode 2: Embedded Replica (Edge)
#   TURSO_REPLICA_ENABLED=true
#   TURSO_REPLICA_MODE=embedded
#   Best for: CDN edge, offline-first, low-latency reads
#
# Mode 3: Multi-Replica (Global)
#   TURSO_REPLICA_ENABLED=true
#   TURSO_NODES='[...]'
#   Best for: Global apps, high availability, geo-distribution
#
# =============================================================================
