# PersonalityMatch - Cost-Optimized Configuration
# Target: $20/month total cost
#
# Copy this file to .env and fill in your values
# This configuration uses SQLite + Wompi for maximum cost savings

# ============================================================================
# ENVIRONMENT
# ============================================================================
NODE_ENV=production

# ============================================================================
# DATABASE - SQLite (Cost: $0/month)
# ============================================================================
DB_TYPE=sqlite
SQLITE_PATH=./data/personalitymatch.db

# Optional: Use PostgreSQL for high-scale (requires separate instance)
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=personalitymatch
# DB_USER=postgres
# DB_PASSWORD=your_password

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_change_me
JWT_EXPIRES_IN=7d

# ============================================================================
# GOOGLE OAUTH 2.0
# ============================================================================
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/auth/google/callback

# ============================================================================
# WOMPI PAYMENT GATEWAY (Colombian)
# Cost: 2.49% + COP 600 (~$0.15 USD) per transaction
# vs Stripe: 2.9% + $0.30 USD
# Savings: ~$21/month on 100 transactions
#
# Documentation: https://docs.wompi.co/en/docs/colombia/referencia/
# Get credentials from: https://comercios.wompi.co/
# ============================================================================

# Wompi API Keys
WOMPI_PUBLIC_KEY=pub_test_your_public_key_here
WOMPI_PRIVATE_KEY=prv_test_your_private_key_here
WOMPI_INTEGRITY_SECRET=your_integrity_secret_here

# Environment: sandbox or production
WOMPI_ENVIRONMENT=sandbox

# Currency (Colombian Peso)
WOMPI_CURRENCY=COP

# Unlock Price
UNLOCK_PRICE_USD=1.00

# Exchange Rate (USD to COP)
# Update periodically or use real-time API
# Current rate: ~4000 COP = 1 USD
USD_TO_COP_RATE=4000

# ============================================================================
# EMAIL - Brevo (formerly Sendinblue)
# Cost: FREE up to 300 emails/day
# vs Paid SMTP: $15-25/month
# Savings: $15-25/month
#
# Get free account: https://www.brevo.com/
# ============================================================================

SMTP_HOST=smtp-relay.sendinblue.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email
SMTP_PASSWORD=your_brevo_smtp_key
EMAIL_FROM=noreply@yourdomain.com

# Alternative: Gmail (free but limited)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_gmail@gmail.com
# SMTP_PASSWORD=your_gmail_app_password

# ============================================================================
# REDIS CACHE (Optional)
# Cost: $0 (running on same VPS)
# If using managed Redis: $10-15/month
# ============================================================================

REDIS_URL=redis://localhost:6379

# ============================================================================
# FRONTEND URL
# Cost: FREE (Vercel/Netlify free tier)
# vs S3+CloudFront: $6/month
# Savings: $6/month
# ============================================================================

FRONTEND_URL=https://yourdomain.com

# ============================================================================
# DATA ENCRYPTION
# ============================================================================
# Generate with: openssl rand -hex 16
# Must be 32 hex characters (16 bytes)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ============================================================================
# FILE UPLOADS
# ============================================================================

# Maximum video file size (50MB)
MAX_VIDEO_SIZE=50000000

# Upload directory (local storage)
UPLOAD_DIR=./uploads

# ============================================================================
# SECURITY & RATE LIMITING
# ============================================================================

# Rate limiting (15 minutes window)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window per IP
RATE_LIMIT_MAX=100

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================

# Backblaze B2 (optional, for automated backups)
# Cost: $0.005/GB/month (10GB = $0.05/month)
# Get free account: https://www.backblaze.com/b2/
BACKUP_B2_ACCOUNT_ID=your_b2_account_id
BACKUP_B2_APP_KEY=your_b2_app_key
BACKUP_B2_BUCKET_NAME=personalitymatch-backups

# ============================================================================
# MONITORING (Optional)
# ============================================================================

# UptimeRobot (Free tier)
# Cost: FREE for 50 monitors
# Get account: https://uptimerobot.com/

# Sentry Error Tracking (optional)
# Cost: FREE for 5K errors/month
# SENTRY_DSN=your_sentry_dsn_here

# ============================================================================
# COST SUMMARY
# ============================================================================
# VPS (Hetzner CPX11): $5/month
# Frontend (Vercel): $0/month
# Database (SQLite): $0/month
# Email (Brevo): $0/month
# Backup (B2): $0.50/month
# Domain: $1/month
# Wompi Fees (100 tx @ $1): ~$12/month
# -------------------------------------------
# TOTAL: ~$18.50/month
#
# Compare to AWS managed services: $104/month
# SAVINGS: $85.50/month (82% reduction!)
