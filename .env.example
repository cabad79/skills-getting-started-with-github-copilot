# PersonalityMatch Environment Configuration
# Copy this file to .env and fill in your values

# Database
DB_NAME=personalitymatch
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Google OAuth
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Stripe
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
UNLOCK_PRICE=100
UNLOCK_CURRENCY=usd

# Email (SMTP)
# For Gmail, generate app password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@personalitymatch.com

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Encryption (Generate 32 random hex characters)
# Example: openssl rand -hex 16
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# File Upload
MAX_VIDEO_SIZE=50000000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
